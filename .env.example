# Copy this file to .env and fill in values locally (or set via the Portal 🔑 AI Key modal):
# cp .env.example .env

# AI / Gemini Configuration (Get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Platform (Optional - Cloud Run / BigQuery / Vertex AI)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1

# Local Development Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Demo Safety Switch (set true to force deterministic local fallback mode)
USE_MOCK_DATA=false
